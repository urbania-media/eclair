{
    "name": "@eclair-js/server",
    "version": "0.0.0",
    "description": "Eclair server: API, scheduler, workers and the eclair CLI",
    "type": "module",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/urbania-media/eclair.git",
        "directory": "packages/server"
    },
    "engines": {
        "node": ">=24"
    },
    "sideEffects": false,
    "exports": {
        ".": {
            "@eclair-js/source": "./src/index.ts",
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "typecheck": "tsc -p tsconfig.json"
    },
    "publishConfig": {
        "access": "public"
    },
    "dependencies": {
        "mysql2": "^3.24.6",
        "pg": "^8.23.1"
    },
    "devDependencies": {
        "@types/pg": "^8.23.1"
    }
}
