{
    "name": "@eclair-js/server",
    "version": "0.0.0",
    "description": "Eclair server: API, scheduler, workers and the eclair CLI",
    "type": "module",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/urbania-media/eclair.git",
        "directory": "packages/server"
    },
    "engines": {
        "node": ">=24"
    },
    "sideEffects": false,
    "exports": {
        ".": {
            "@eclair-js/source": "./src/index.ts",
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "bin": {
        "eclair": "./dist/cli/main.js"
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "typecheck": "tsc -p tsconfig.json"
    },
    "publishConfig": {
        "access": "public"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1152.0",
        "@aws-sdk/lib-storage": "^3.1152.0",
        "@aws-sdk/s3-request-presigner": "^3.1152.0",
        "@eclair-js/operation": "^0.0.0",
        "@eclair-js/operations-audio": "^0.0.0",
        "@eclair-js/operations-core": "^0.0.0",
        "@eclair-js/operations-video": "^0.0.0",
        "@eclair-js/protocol": "^0.0.0",
        "@fastify/multipart": "^10.1.4",
        "ajv": "^8.20.0",
        "ajv-formats": "^3.0.1",
        "bullmq": "^6.3.15",
        "fastify": "^5.12.7",
        "ioredis": "^6.0.0",
        "ipaddr.js": "^2.5.0",
        "kysely": "^0.29.6",
        "mysql2": "^3.24.6",
        "pg": "^8.23.1",
        "pino": "^10.4.0",
        "prom-client": "^15.1.3",
        "typebox": "^1.3.37",
        "ulid": "^3.0.2",
        "undici": "^8.12.2"
    },
    "devDependencies": {
        "@types/pg": "^8.23.1"
    }
}
