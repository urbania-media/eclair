{
    "name": "@eclair-js/protocol",
    "version": "0.0.0",
    "description": "The Eclair protocol: OpenAPI document, JSON Schemas and TypeScript types",
    "type": "module",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/urbania-media/eclair.git",
        "directory": "packages/protocol"
    },
    "engines": {
        "node": ">=24"
    },
    "sideEffects": false,
    "exports": {
        ".": {
            "@eclair-js/source": "./src/index.ts",
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./openapi.json": "./schema/openapi.json",
        "./eclair.schema.json": "./schema/eclair.schema.json",
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "schema"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "typecheck": "tsc -p tsconfig.json",
        "generate": "node scripts/generate.ts"
    },
    "publishConfig": {
        "access": "public"
    },
    "dependencies": {
        "ajv": "^8.20.0",
        "ajv-formats": "^3.0.1"
    },
    "devDependencies": {
        "@readme/openapi-parser": "^9.1.0",
        "openapi-typescript": "^7.13.0"
    }
}
