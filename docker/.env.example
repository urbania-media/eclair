# Configuration of Eclair for compose.yml and compose.mysql.yml. Copy this file to .env, next to
# them, and fill in the empty values. Every variable is described in docs/deployment.md.

# Image tag: latest, a version (0.1.0) or main.
ECLAIR_VERSION=latest

# Key that encrypts storage credentials and provider keys: `openssl rand -base64 32`.
# Keep it safe: losing it means registering storages again.
ECLAIR_SECRET_KEY=
# Token for the admin API and the CLI: `openssl rand -hex 32`.
ECLAIR_ADMIN_TOKEN=
# Public URL of the API, as your reverse proxy serves it.
ECLAIR_PUBLIC_URL=https://eclair.example.com
# Port the API listens on. The compose files publish it on 127.0.0.1 only.
ECLAIR_PORT=8080

# Password of the eclair database user: `openssl rand -hex 24`. The compose files use it to create
# the database and to set DATABASE_URL and REDIS_URL. Without them, set those two instead:
# mysql://…, postgres://… or sqlite:///var/lib/eclair/eclair.db, and redis://….
DATABASE_PASSWORD=
# DATABASE_URL=
# REDIS_URL=

# Queues the worker serves, with optional concurrency (cpu:4,video:1). Every worker also serves
# probe, unless probe:0.
ECLAIR_QUEUES=cpu,video

# Temporary directory for tasks, on a fast local disk: the only writable path for tasks.
ECLAIR_TMP_DIR=/tmp/eclair

# Temporary storage: a local path on a single server, or an S3-compatible bucket (s3://…).
ECLAIR_TEMP_STORAGE=file:///var/lib/eclair/storage
ECLAIR_TEMP_RETENTION=24h
ECLAIR_TEMP_MAX_RETENTION=7d

# Extra operation packages to load, separated by commas.
ECLAIR_PLUGINS=

# Defaults that projects and operations can override.
ECLAIR_MAX_INPUT_SIZE=2GB
ECLAIR_TASK_TIMEOUT=1h

# How long ended jobs are kept.
ECLAIR_JOB_RETENTION=30d
